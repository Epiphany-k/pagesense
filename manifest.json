{
  "manifest_version": 3,
  "name": "PageSense 网页摘要与解释",
  "version": "0.2.0",
  "description": "一键摘要网页、划词解释：结果以页面内悬浮窗流式展示，支持自定义 LLM API。",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared/constants.js", "shared/markdown.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PageSense 网页摘要与解释",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "summarize": {
      "suggested_key": { "default": "Alt+S" },
      "description": "摘要当前页面"
    },
    "explain": {
      "suggested_key": { "default": "Alt+E" },
      "description": "解释选中内容"
    }
  }
}
